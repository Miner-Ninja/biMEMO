#!/usr/bin/env sh
# Format staged frontend files with Prettier
# Get list of staged files in app/frontend/
STAGED=$(git diff --cached --name-only | grep "^app/frontend/" || true)
if [ -n "$STAGED" ]; then
  echo "$STAGED" | xargs npx --prefix app/frontend prettier --write --ignore-unknown --ignore-path app/frontend/.prettierignore 2>/dev/null
  # Re-stage the formatted files
  echo "$STAGED" | xargs git add 2>/dev/null
fi
