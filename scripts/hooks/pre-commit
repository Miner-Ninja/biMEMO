#!/usr/bin/env python3
"""biMEMO pre-commit hook: the fast subset of the pre-merge gate.

Activated once per clone with:

    git config core.hooksPath scripts/hooks

It runs at every commit, in the same disposable containers as
scripts/verify.py, so the hook and the gate share one source of truth
for tool versions and configuration:

  1. ruff check          - lint (app/backend, tests, scripts)
  2. ruff format --check - formatting
  3. gitleaks protect --staged - no secrets may be committed (scans
                           the staged content, i.e. what this commit adds)

The hook never modifies files. A non-zero exit blocks the commit;
bypass it deliberately with: git commit --no-verify
"""

import json
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent.parent
COMPOSE_FILE = REPO_ROOT / "docker" / "docker-compose.yml"
GITLEAKS_IMAGE = "ghcr.io/gitleaks/gitleaks:latest"
RUFF_TARGETS = ["app/backend", "tests", "scripts"]


def sh(command: list[str]) -> None:
    """Run a command in the repo root; a non-zero exit blocks the commit."""
    print("$ " + " ".join(command))
    result = subprocess.run(command, cwd=REPO_ROOT)
    if result.returncode != 0:
        print(
            "pre-commit: findings above; the commit is blocked "
            f"(exit {result.returncode}). Fix them, or bypass "
            "deliberately with: git commit --no-verify",
            file=sys.stderr,
        )
        sys.exit(1)


def compose_project() -> str:
    """The compose project name (e.g. 'docker' from docker/docker-compose.yml)."""
    output = subprocess.run(
        ["docker-compose", "-f", str(COMPOSE_FILE), "config", "--format", "json"],
        cwd=REPO_ROOT,
        check=True,
        capture_output=True,
        text=True,
    ).stdout
    return json.loads(output)["name"]


def require_docker() -> None:
    """The hook needs the docker daemon; fail loudly if it is not up."""
    result = subprocess.run(["docker", "info"], capture_output=True)
    if result.returncode != 0:
        print(
            "pre-commit: the docker daemon is not reachable; the hook "
            "needs it (same as the gate). Start docker, or bypass "
            "deliberately with: git commit --no-verify",
            file=sys.stderr,
        )
        sys.exit(1)


def main() -> None:
    require_docker()
    image = f"{compose_project()}-bimemo:latest"

    print("==> pre-commit [1/3] ruff check (disposable container)")
    sh(
        [
            "docker",
            "run",
            "--rm",
            "-v",
            f"{REPO_ROOT}:/repo",
            "-w",
            "/repo",
            "-e",
            "PYTHONPATH=/repo/app",
            image,
            "ruff",
            "check",
            *RUFF_TARGETS,
        ]
    )

    print("==> pre-commit [2/3] ruff format --check (disposable container)")
    sh(
        [
            "docker",
            "run",
            "--rm",
            "-v",
            f"{REPO_ROOT}:/repo",
            "-w",
            "/repo",
            "-e",
            "PYTHONPATH=/repo/app",
            image,
            "ruff",
            "format",
            "--check",
            *RUFF_TARGETS,
        ]
    )

    print("==> pre-commit [3/3] gitleaks: secrets in the staged content")
    sh(
        [
            "docker",
            "run",
            "--rm",
            "-v",
            f"{REPO_ROOT}:/repo",
            "-w",
            "/repo",
            GITLEAKS_IMAGE,
            "protect",
            "--staged",
            "--config",
            ".gitleaks.toml",
            "--redact",
        ]
    )

    print("pre-commit: all checks passed")


if __name__ == "__main__":
    main()
