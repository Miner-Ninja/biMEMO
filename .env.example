# biMEMO configuration — copy to .env and review before first start.
# Only the "Core" and "SearXNG" values below are required for the default
# development Docker Compose stack.
#
# LLM providers and bot integrations can be configured in the Admin UI after
# first startup. Uncomment the optional seed variables below only when you want
# repeatable environment-based setup.
#
# --- Migration from old single-process mode ---
# If you're upgrading from the Argon2id-encrypted key file setup:
#   1. Run: python -m backend.security.migrate <encrypted_key_path> <output_key_path>
#   2. Set BIMEMO_KEY_SOURCE=file
#   3. Set BIMEMO_KEY_FILE_PATH=<output_key_path>
#   4. Remove the old BIMEMO_MASTER_KEY_PATH variable
#   5. Redeploy the container

# --- Core (REQUIRED) ---
BIMEMO_DEBUG=false
BIMEMO_HOST=0.0.0.0
BIMEMO_PORT=8000
BIMEMO_KEY_SOURCE=file
BIMEMO_KEY_FILE_PATH=/data/keyfile/master.key
BIMEMO_DATABASE_PATH=/data/db/bimemo.db
BIMEMO_DIAGNOSTICS_RETENTION_DAYS=14

# --- Ollama runtime config (optional — seeded into DB on startup) ---
# BIMEMO_LLM_PROVIDER=ollama
# BIMEMO_OLLAMA_BASE_URL=http://host.docker.internal:11434
# BIMEMO_OLLAMA_DIALOG_RECORDER_BASE_URL=http://host.docker.internal:11434
# BIMEMO_OLLAMA_MODEL=qwen3:14b
# BIMEMO_OLLAMA_DIALOG_RECORDER_MODEL=qwen3:4b
# BIMEMO_OLLAMA_NUM_CTX=16384

# --- Caddy → Ollama Bearer token (optional, used by the non-dev Caddyfile) ---
# The default dev compose stack does not require this value.
# Generate with: openssl rand -hex 32
# OLLAMA_BEARER_TOKEN=

# --- OpenRouter runtime config (optional — seeded into DB on startup) ---
# BIMEMO_LLM_PROVIDER=openrouter
# BIMEMO_OPENROUTER_API_KEY=<your-openrouter-api-key>
# BIMEMO_OPENROUTER_MODEL=qwen/qwen3-14b
# BIMEMO_OPENROUTER_DIALOG_RECORDER_MODEL=qwen/qwen3-4b

# --- SearXNG (web search backend, REQUIRED) ---
BIMEMO_SEARXNG_URL=http://searxng:8080/search

# --- Telegram bot (optional — seeded into DB on startup, overrides Admin UI config) ---
# BIMEMO_TELEGRAM_BOT_TOKEN=
# BIMEMO_TELEGRAM_ALLOWED_USER_IDS=

# --- Discord bot (optional — seeded into DB on startup, overrides Admin UI config) ---
# BIMEMO_DISCORD_BOT_TOKEN=
# BIMEMO_DISCORD_ALLOWED_USER_IDS=
# BIMEMO_DISCORD_PERSONA_USER_IDS=

# --- Speech-to-Text (optional — self-hosted faster-whisper) ---
BIMEMO_WHISPER_ENDPOINT=http://whisper:8000
BIMEMO_WHISPER_LANGUAGE=en

# --- Text-to-Speech (optional — self-hosted Fish Speech S2 Pro) ---
# BIMEMO_TTS_ENDPOINT=http://fish-speech:8080
# BIMEMO_TTS_VOICE_ID=
